n\n\n\n\n\n<a href=\"https://myaudit.youracsa.ca/\"><img alt=\"\" src=\"/images/ACSA/MyAuditLogo.jpg?version=E774E18D\" style=\"\"/></a>\n\n\n\n\n\n\n\n\n\n\n\n\nToggle navigation\n\n\n\n\n\n<ul class=\"NavigationUnorderedList\"><li class=\"NavigationListItem nav-aux-button nav-aux-cart\" id=\"ctl01_ciNewUtilityNavigationCommon_ctl03__rptWrapper__rptWrapper_rpt_ctl01_NavigationListItem\"><a class=\"NavigationLink\" href=\"/ACSA/ACSA/Store/StoreLayouts/Cart_Home.aspx?hk...\" id=\"ctl01_ciNewUtilityNavigationCommon_ctl03__rptWrapper__rptWrapper_rpt_ctl01_NavigationLink\" onclick=\"MenuLI_OnClick('/ACSA/ACSA/Store/StoreLayouts/Cart_Home.aspx?hkey=2f0d5291-3301-472d-b627-564f8b98cb4e')\">Cart </a></li><li class=\"NavigationListItem\" id=\"ctl01_ciNewUtilityNavigationCommon_ctl03__rptWrapper__rptWrapper_rpt_ctl02_NavigationListItem\"><a class=\"NavigationLink\" href=\"https://youracsa.ca\" id=\"ctl01_ciNewUtilityNavigationCommon_ctl03__rptWrapper__rptWrapper_rpt_ctl02_NavigationLink\" onclick=\"MenuLI_OnClick('https://youracsa.ca')\">ACSA Home Page</a></li></ul>\n\n<a class=\"UtilitySection UtilityAuthenticationLink sign-in-link\" href=\"javascript:__doPostBack('ctl01$ciNewUtilityNavi...\">Sign in</a>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<h2 class=\"panel-title\" translate=\"yes\">Returning Student</h2>\n\n\n\n\n\n\n\n\n\n\n\n\n<label class=\"contact-signin-label\" for=\"ctl01_TemplateBody_WebPartManager1_gwpciNewContactSignInCommon_ciNewContactSignInCommon_signInUserName\" id=\"ctl01_TemplateBody_WebPartManager1_gwpciNewContactSignInCommon_ciNewContactSignInCommon_signInUserNameLabel\" style=\"width: 100%; display: inline-block;\" translate=\"yes\">Username (Your ACSA ID)</label>\n\n\n<a aria-label=\"Click this link if you forgot your username.\" href=\"../../iParts/Contact%20Management/ContactSignIn...\" id=\"ctl01_TemplateBody_WebPartManager1_gwpciNewContactSignInCommon_ciNewContactSignInCommon_inlineForgotUsername\">Forgot?</a>\n\nRequired\n\n\n<label class=\"contact-signin-label\" for=\"ctl01_TemplateBody_WebPartManager1_gwpciNewContactSignInCommon_ciNewContactSignInCommon_signInPassword\" id=\"ctl01_TemplateBody_WebPartManager1_gwpciNewContactSignInCommon_ciNewContactSignInCommon_signInPasswordLabel\" translate=\"yes\">Password</label>\n\n\n<a aria-label=\"Click this link if you forgot your pasword.\" href=\"../../iParts/Contact%20Management/ContactSignIn...\" id=\"ctl01_TemplateBody_WebPartManager1_gwpciNewContactSignInCommon_ciNewContactSignInCommon_inlineForgotPassword\">Forgot?</a>\n\nRequired\n\n\n\n\n\n\n\n\n\n\n<a class=\"NoWrap\" href=\"../../iParts/Contact%20Management/ContactSignIn...\">Forgot username?</a> | <a class=\"NoWrap\" href=\"../../iParts/Contact%20Management/ContactSignIn...\">Forgot password?</a>\n\n\n\n<a id=\"ctl01_TemplateBody_WebPartManager1_gwpciNewContactSignInCommon_ciNewContactSignInCommon_accountLink\"></a>\n\n\n\n\n\n\n\n\n\n<h4 class=\"modal-title d-inline\" id=\"ctl01_TemplateBody_WebPartManager1_gwpciNewContactSignInCommon_ciNewContactSignInCommon_ConfirmMultiFactorEmailTitle\">Create new MFA token?</h4>\n×\n\n\nCreating a new MFA token will reset any existing tokens for this login. Do you wish to proceed?\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<h2 style=\"text-align: center;\">First time signing in to MyAudit? </h2>\n<p style=\"text-align: center;\">click the button below</p>\n\n\n\n\n\n\n\n\n\n\n<ul class=\"BigButtonList\" id=\"ctl01_TemplateBody_WebPartManager1_gwpciButtonLink_ciButtonLink_DivRight_List\">\n<li>\n<a class=\"TextButton ButtonItem\" href=\"myaudit.youracsa.ca\" id=\"ctl01_TemplateBody_WebPartManager1_gwpciButtonLink_ciButtonLink_LinkRepeater_ctl01_Link\">New to MyAudit</a>\n</li>\n</ul>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<img alt=\"\" src=\"/images/ACSA/ACSASignin.png?version=E7F5B1AA\" style=\"\"/>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<h3>Support by phone</h3>\n1.800.661.2272\n(8:00am to 4:30pm, Monday –Friday)\n\n\n<h3>Support by e-mail</h3>\n<a href=\"mailto:support@youracsa.ca\">support@youracsa.ca</a>\n(Following business day)\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<a class=\"bg-img-conference-small banner-short\" href=\"/IMISAnnualConference\">\n\n<h2>Annual Conference</h2>\n<p><strong>An engaging three-day event you won't want to miss.</strong></p>\nRegister Now\n\n</a>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n \n\n\n<link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css\" rel=\"stylesheet\"/>\n<a class=\"fa fa-twitter\" href=\"https://twitter.com/OfficialACSA\"></a>\n<a class=\"fa fa-facebook\" href=\"https://www.facebook.com/ACSA.safety\"></a>\n<a class=\"fa fa-linkedin\" href=\"www.linkedin.com\"></a>\n<a class=\"fa fa-youtube-play\" href=\"www.youtube.com\"></a>\n<a class=\"fa fa-envelope-o\" href=\"mailto:cor@youracsa.ca\"></a>\n\n\n<ul class=\"footer\" id=\"menu-acsa-footer\">\n<li class=\"\" id=\"\"><a href=\"http://youracsa.ca/\" style=\"text-decoration: none;\">Your ACSA Homepage</a></li>\n<li class=\"\" id=\"\"><a href=\"https://www.youracsa.ca/cor-secor/2023-audit-tool/\" style=\"text-decoration: none;\">Resources and Tools</a></li>\n<li class=\"\" id=\"\"><a href=\"https://www.youracsa.ca/myaudit/\" style=\"text-decoration: none;\">FAQ</a></li>\n<li class=\"\" id=\"\"><a href=\"https://www.youracsa.ca/about-us/contact-us/\" style=\"text-decoration: none;\">Contact Us</a></li>\n</ul>\n\n\n \n\n\n<p style=\"text-align: right;\"><img alt=\"\" src=\"/images/ACSA/acsa-logoRGB-tm.png?version=9D2BCC3\" style=\"\"/></p>\n \n\n\n\n\n\n\n\n\n\n\n\n\n\n<p style=\"text-align: center;\">Copyright © 2024 <strong>Alberta Construction Safety Association</strong>. All rights reserved.</p>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n×\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n            {1}\n            \n\n<a class=\"rwPopupButton\" href=\"javascript:void(0);\" 