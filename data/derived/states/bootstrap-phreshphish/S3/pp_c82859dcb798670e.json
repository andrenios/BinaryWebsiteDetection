\"/>\n<meta content=\"2000\" property=\"og:image:width\"/>\n<meta content=\"1270\" property=\"og:image:height\"/>\n<meta content=\"image/jpeg\" property=\"og:image:type\"/>\n<meta content=\"Kyann-Sian Williams\" name=\"author\"/>\n<meta content=\"summary_large_image\" name=\"twitter:card\"/>\n<meta content=\"@nme\" name=\"twitter:creator\"/>\n<meta content=\"@nme\" name=\"twitter:site\"/>\n<meta content=\"Written by\" name=\"twitter:label1\"/>\n<meta content=\"Kyann-Sian Williams\" name=\"twitter:data1\"/>\n<meta content=\"Estimated reading time\" name=\"twitter:label2\"/>\n<meta content=\"4 minutes\" name=\"twitter:data2\"/>\n\n\n<link href=\"//www.nme.com\" rel=\"dns-prefetch\"/>\n<link href=\"//www.googletagmanager.com\" rel=\"dns-prefetch\"/>\n<link href=\"https://www.nme.com/feed\" rel=\"alternate\" title=\"NME » Feed\" type=\"application/rss+xml\"/>\n\n\n\n\n\n\n<link href=\"https://www.nme.com/wp-content/plugins/easy-liveblogs/assets/css/themes/light.css?ver=2.3.7\" id=\"elb-theme-light-css\" media=\"all\" rel=\"stylesheet\" type=\"text/css\"/>\n<link href=\"https://www.nme.com/wp-content/plugins/td-composer/td-multi-purpose/style.css?ver=978887166a39c57c36d5cf4a5ec10289\" id=\"td-plugin-multi-purpose-css\" media=\"all\" rel=\"stylesheet\" type=\"text/css\"/>\n<link href=\"https://www.nme.com/wp-content/themes/Newspaper/style.css?ver=11-2024102501\" id=\"td-theme-css\" media=\"all\" rel=\"stylesheet\" type=\"text/css\"/>\n\n<link href=\"https://www.nme.com/wp-content/themes/Newspaper-child/style.css?ver=11-2024102501\" id=\"td-theme-child-css\" media=\"all\" rel=\"stylesheet\" type=\"text/css\"/>\n<link href=\"https://www.nme.com/wp-content/plugins/td-composer/legacy/Newspaper/assets/css/td_legacy_main.css?ver=978887166a39c57c36d5cf4a5ec10289\" id=\"td-legacy-framework-front-style-css\" media=\"all\" rel=\"stylesheet\" type=\"text/css\"/>\n<link href=\"https://www.nme.com/wp-content/plugins/td-standard-pack/Newspaper/assets/css/td_standard_pack_main.css?ver=9